# Backend API base URL — copy this file to .env.local and set the correct value.
#
# Localhost (.NET via `dotnet run --launch-profile http`):
# NEXT_PUBLIC_API_BASE_URL=http://localhost:5105
#
# Localhost (.NET via `dotnet run --launch-profile https`):
# NEXT_PUBLIC_API_BASE_URL=https://localhost:7129
#
# Docker (`docker compose up --build -d`):
# NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
#
# Render (production) — also the built-in fallback when this var is unset:
# NEXT_PUBLIC_API_BASE_URL=https://ppmv2-hbb4.onrender.com

NEXT_PUBLIC_API_BASE_URL=http://localhost:5105
